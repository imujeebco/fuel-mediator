# FuelPay Mediator on Apache (CWP / shared hosting): becomes core-engine/public/.htaccess in the upload package.
# Every request goes to the app. Device endpoints and /health are open; the dashboard and its actions require the
# admin login (ADMIN_PASSWORD_HASH), since a host without SSH has no private tunnel to reach it.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # FuelPay sends Authorization on some PTS requests; keep it visible to PHP.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Never serve dotfiles (.env lives outside public/, this is defence in depth).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Long calls: mobile_close_shift waits up to 55 s for Odoo.
<IfModule mod_php.c>
    php_value max_execution_time 70
</IfModule>
