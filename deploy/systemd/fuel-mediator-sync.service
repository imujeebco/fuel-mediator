[Unit]
Description=FuelPay Mediator sync: mirror Odoo sales and POS sessions for all stations, then link fills to sales
After=network-online.target mysql.service

[Service]
Type=oneshot
User=fuelmed
Group=fuelmed
WorkingDirectory=/opt/fuel-mediator/core-engine
ExecStart=/usr/bin/php yii sync:run
TimeoutStartSec=55
StandardOutput=append:/var/log/fuel-mediator/sync.log
StandardError=append:/var/log/fuel-mediator/sync.log
