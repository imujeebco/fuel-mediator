# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fuel_mediator
DB_USER=root
DB_PASSWORD=

# Odoo (read-only access for station import and the Odoo reader; never commit real values)
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# Retention for high-volume journal tables, in days
RETENTION_DAYS=90

# PTS controller secrets, one per controller: PTS_PASSWORD_<odoo backend config id> (decision D17)
# PTS_PASSWORD_2=

# Public base URL of this mediator as devices reach it (enables the PTS URL rewrite, decision D1)
MEDIATOR_PUBLIC_URL=

# Decision D21: report fills already paid by another sale as paid to devices ("0" switches it off)
SETTLED_FILL_FILTER=1
# Decision D28: a PTS fill paid by a manual sale on the same pump is reported as paid at once ("0" switches it off)
SETTLED_FILL_LIVE=1

# Decision D23: key for controller passwords read from Odoo and stored encrypted (yii secret:generate-key)
MEDIATOR_SECRET_KEY=

# Dashboard login (hash from /login/password-hash). Empty = dashboard reachable only from this machine
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
