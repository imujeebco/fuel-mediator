<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    ensureOverrideAttribute="false"
    strictBinaryOperands="false"
    cacheDirectory="./runtime/cache/psalm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <file name="public/index.php" />
        <file name="yii" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <MixedAssignment errorLevel="suppress" />
        <RiskyTruthyFalsyComparison errorLevel="suppress" />
        <!-- Admin view templates read loosely typed row arrays by design; classes stay at level 1. -->
        <MixedArrayAccess>
            <errorLevel type="suppress">
                <directory name="src/Web/Admin/views" />
                <file name="src/Web/Admin/layout.php" />
            </errorLevel>
        </MixedArrayAccess>
        <MixedArgument>
            <errorLevel type="suppress">
                <directory name="src/Web/Admin/views" />
                <file name="src/Web/Admin/layout.php" />
            </errorLevel>
        </MixedArgument>
        <MixedOperand>
            <errorLevel type="suppress">
                <directory name="src/Web/Admin/views" />
                <file name="src/Web/Admin/layout.php" />
            </errorLevel>
        </MixedOperand>
        <MixedMethodCall>
            <errorLevel type="suppress">
                <directory name="src/Web/Admin/views" />
                <file name="src/Web/Admin/layout.php" />
            </errorLevel>
        </MixedMethodCall>
        <PossiblyUndefinedArrayOffset>
            <errorLevel type="suppress">
                <directory name="src/Web/Admin/views" />
                <file name="src/Web/Admin/layout.php" />
            </errorLevel>
        </PossiblyUndefinedArrayOffset>
        <InvalidScope>
            <errorLevel type="suppress">
                <directory name="src/Web/Admin/views" />
                <file name="src/Web/Admin/layout.php" />
            </errorLevel>
        </InvalidScope>
    </issueHandlers>
</psalm>
